# --- Robinhood (unofficial API via robin_stocks) ---
RH_USERNAME=
RH_PASSWORD=
# Base32 secret shown when you enable an authenticator app for 2FA in Robinhood
RH_TOTP_SECRET=
# Name of an existing custom watchlist in the Robinhood app
RH_WATCHLIST_NAME=Portfolio

# --- News sources ---
# Free key at https://finnhub.io (company news). Optional; SEC EDGAR needs no key.
FINNHUB_API_KEY=
# SEC requires a contact in the User-Agent: "Name email@example.com"
SEC_USER_AGENT=

# --- Notifications (any/all; falls back to stdout) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# --- Tuning ---
STATE_PATH=state/state.json
MIN_MATERIALITY=3
LOOKBACK_HOURS=36
